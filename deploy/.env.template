# Copy to .env next to docker-compose.yml. Values below work for a local run without changes.

# Images built by `docker compose build` in the docker/ folder of each repository
API_IMAGE=senswave-senswave.api:latest
SEED_IMAGE=senswave-senswave.seed:latest
WEB_IMAGE=sesnwave-web-senswave.web:latest

# Ports on this machine
WEB_PORT=7162
API_PORT=7070
SMTP_UI_PORT=7777

# Web client: address the browser uses to reach the API
API_BASE_ADDRESS=http://localhost:7070
GOOGLE_CLIENT_ID=

# API
ASPNETCORE_URLS=http://+:8080;http://+:5001
ASPNETCORE_ENVIRONMENT=Production
# CORS: the web client origin. Must match http://localhost:${WEB_PORT}.
Cors__Enabled=true
Cors__AllowedOrigins__0=http://localhost:7162
Cors__AllowedOrigins__1=http://localhost:5246
# No telemetry collector in this setup
Diagnostics__OpenTelemetry__Enabled=false
# The API connects to MQTT brokers itself, so no data source worker is needed.
# Required with the in-memory message bus: the worker could not reach the API's in-memory bus.
Modules__DataSource__Brokers__IsCluster=false
Modules__Users__Auth__Google__ClientId=
Modules__Users__Auth__Google__ClientSecret=

# Database
PostgreSql__Host=database
PostgreSql__Port=5432
PostgreSql__Database=senswave
PostgreSql__Username=postgres
PostgreSql__Password=postgres

# Message bus: in memory, inside the API process. No RabbitMQ container.
MessageBus__Type=InMemory

# SMTP: emails are caught by smtp4dev, open http://localhost:7777 to read them
Smtp__Enabled=true
Smtp__User=test
Smtp__Password=test
Smtp__Host=smtp
Smtp__Port=25
Smtp__SenderEmail=test_sender@senswave.com
Smtp__UseSsl=false

# Seed (optional profile)
Seed__Instance=http://api:8080/api
