@page "/devices/dashboard/{Id}"
@attribute [Authorize]

@using Senswave.Web.Devices.Components
@using Senswave.Web.Devices.Integration
@using Senswave.Web.LiveUpdate.Models
@using Senswave.Web.LiveUpdate.Services
@using Senswave.Web.Shared.Components
@using Senswave.Web.Shared.Resulting

@inject ILogger<Dashboard> Logger
@inject IDashboardIntegrationService DashboardIntegrationService
@inject ISnackbar Snackbar
@inject IErrorFactory ErrorFactory
@inject NavigationManager Navigation
@inject ILiveUpdateService LiveUpdateService
@inject IDialogService DialogService
@inject IDeviceIntegrationService DeviceIntegrationService

@implements IDisposable

<PageTitle>@PageName()</PageTitle>

<SensPage Loading="@_loading" FailedToLoad="@_failedToLoad" RefreshContent="@RefreshPage" Breadcrumbs="@Breadcrumbs">
    <LoadingContent>

        <MudContainer MaxWidth="MaxWidth.Small" Class="display-flex flex-1 justify-content-center align-items-center">
            <MudGrid Class="display-flex flex-1 justify-content-center align-items-center">
                <MudItem Class="display-flex flex-1 justify-content-center align-items-center" xs="12">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2 flex-grow-1 display-flex" Style="height: 65vh;" />
                </MudItem>

                <MudItem xs="12">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="height: 8vh;" />
                </MudItem>
            </MudGrid>
        </MudContainer>

    </LoadingContent>
    <Content>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column gap-3 p-0">

            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div class="d-flex align-center gap-3" style="min-width:0;">
                    @if (Device is not null)
                    {
                        <SensIcon Icon="@Device.Icon" Size="Size.Large" />
                    }
                    <div class="d-flex flex-column" style="min-width:0;">
                        <MudText Typo="Typo.h5" HtmlTag="h1" Class="text-truncate">@DeviceName()</MudText>
                        @if (EditMode)
                        {
                            <MudText Typo="Typo.caption">
                                @(SelectionMode ? "Resize the selection, then place a widget." : "Pick an empty cell to place a widget, or delete one.")
                            </MudText>
                        }
                    </div>
                </div>

                <div class="d-flex align-center gap-1">
                    @if (EditMode)
                    {
                        @if (SelectionMode)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Rounded.Check"
                                       OnClick="CreateWidget">
                                Place widget
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Rounded.EditOff"
                                   OnClick="ToogleEditMode">
                            Done
                        </MudButton>
                    }
                    else
                    {
                        <MudTooltip Text="Refresh">
                            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" aria-label="Refresh" OnClick="RefreshPage" />
                        </MudTooltip>
                        <MudTooltip Text="Edit layout">
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit" aria-label="Edit layout" OnClick="ToogleEditMode" />
                        </MudTooltip>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.Tune"
                                   OnClick="DeviceDetails">
                            Configure
                        </MudButton>
                    }
                </div>
            </div>

            @if (Dashboards.Count > 1)
            {
                <MudTabs ActivePanelIndex="_currentIndex"
                         ActivePanelIndexChanged="OnClick"
                         Elevation="0"
                         Border="false"
                         MinimumTabWidth="80px"
                         Color="Color.Transparent"
                         SliderColor="Color.Primary"
                         Rounded="false">
                    @foreach (var dashboard in Dashboards)
                    {
                        <MudTabPanel Text="@dashboard.Name" Disabled="@EditMode" />
                    }
                </MudTabs>
            }

            @if (CurrentConfiguration != null)
            {
                <div class="d-flex flex-column" style="@(EditMode ? "height: calc(100vh - 220px); min-height: 360px;" : string.Empty)">
                    <SensDashboard Rows="CurrentConfiguration.Rows"
                                   Id="@CurrentDashboard!.Id"
                                   Name="@(CurrentDashboard?.Name ?? string.Empty)"
                                   @bind-EditMode="EditMode"
                                   @bind-SelectionMode="SelectionMode"
                                   @bind-Row="Row"
                                   @bind-Column="Column"
                                   @bind-RowSpan="RowSpan"
                                   @bind-ColumnSpan="ColumnSpan"
                                   Columns="CurrentConfiguration.Columns"
                                   PositionedWidgets="@CurrentConfiguration.PositionedWidgets"
                                   CalculatedWidgets="@CurrentConfiguration.CalculatedWidgets"
                                   OnUnlinkWidget="UnlinkWidget"/>
                </div>
            }

        </MudContainer>
    </Content>
</SensPage>

@code {

    public int Row { get; set; }
    public int Column { get; set; }
    public int RowSpan { get; set; }
    public int ColumnSpan { get; set; }

    private List<BreadcrumbItem> Breadcrumbs => [
        new("Home Dashboard", "/devices", false, $"{Icons.Material.Filled.Dashboard}"),
        new(DeviceName(), $"/devices/dashboard/{Id}", false, $"{Icons.Material.Filled.SpaceDashboard}")
    ];

    private string PageName() => Device is null ? "Device Dashboard" : $"{Device.Name} - {CurrentDashboard?.Name}";

    private string DeviceName() => Device?.Name ?? "Device";

    private DeviceDto? Device { get; set; }

    private int _currentIndex = 0;

    private void OnClick(int index)
    {
        if (Dashboards.Count == 0) return;

        _currentIndex = index;
        UpdateActiveDashboard();
    }

    private void UpdateActiveDashboard()
    {
        CurrentDashboard = Dashboards.ElementAtOrDefault(_currentIndex);
        CurrentConfiguration = Grids.ElementAtOrDefault(_currentIndex);
        StateHasChanged();

        Logger.LogInformation("Switched to dashboard index {Index}: {Name}",
            _currentIndex, CurrentDashboard?.Name);
    }

    private bool _loading = true;
    private bool _failedToLoad = true;

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private List<DashboardDto> Dashboards = [];

    private List<GridDashboardConfiguration> Grids = [];

    private DashboardDto? CurrentDashboard { get; set; }

    private GridDashboardConfiguration? CurrentConfiguration { get; set; }

    #region WidgetManagement

    private bool EditMode;

    private bool SelectionMode;

    private void ToogleEditMode()
    {
        if (EditMode)
        {
            EditMode = false;
            SelectionMode = false;
        }
        else
        {
            EditMode = true;
        }
    }

    private async Task UnlinkWidget(string dashboardId, CalculatedWidgetDto widget)
    {
        try
        {

            var result = await DialogService.ShowMessageBoxAsync(
                "Confirm Unlink", 
            $"Are you sure to unlink {widget.Name} from dashboard?", "Yes", "No", options: new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

            if (result == false)
            {
                return;
            }

            _loading = true;
            StateHasChanged();

            await DashboardIntegrationService.RemoveWidgetFromDashboardAsync(dashboardId, widget.Id);

            await LiteRefresh();


            EditMode = false;
            SelectionMode = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to unlink widget");
            Snackbar.Add("Failed to unlink widget. Please try again", Severity.Error);
        }
        finally
        {
            _loading = false;
        }

        StateHasChanged();
    }

    private async Task CreateWidget()
    {
        try
        {
            var parameters = new DialogParameters<SelectWidgetDialog>
            {
                { x => x.DeviceId, Id }
            };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

            var dialog = await DialogService.ShowAsync<SelectWidgetDialog>("Select Widget", parameters, options);

            var result = await dialog.Result;

            if (result.Canceled || result.Data == null)
            {
                return;
            }

            var widgetId = result.Data.ToString()!;

            _loading = true;
            StateHasChanged();

            var request = new SetWidgetOnDashboardRequest(widgetId, Row, RowSpan, Column, ColumnSpan);

            await DashboardIntegrationService.SetWidgetOnDashboardAsync(CurrentDashboard!.Id, request);

            await LiteRefresh();

            SelectionMode = false;
            EditMode = false;
        }
        catch (Refit.ApiException ex)
        {
            var error = await ErrorFactory.FromApiExceptionAsync(ex, "Failed to place widget on dashboard. Please try again");
            Snackbar.Add(error.Errors.First().Description, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to place widget on dashboard");
            Snackbar.Add("Failed to place widget on dashboard. Please try again", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    #endregion

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        LiveUpdateService.OnUpdate += LiveUpdate;
        await RefreshPage();
    }

    private void DeviceDetails()
    {
        Navigation.NavigateTo($"/devices/details/{Id}");
    }

    private async Task RefreshPage()
    {
        try
        {
            Device = await DeviceIntegrationService.GetDeviceAsync(Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load device {DeviceId} for dashboard header", Id);
        }

        try
        {
            var dashboards = await DashboardIntegrationService.DisplayDashboardsAsync(Id);

            Dashboards = dashboards.Items;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            Snackbar.Add("Create some dashboards first!", Severity.Warning);
            Navigation.NavigateTo($"/devices/details/{Id}");
            return;
        }
        catch (Refit.ApiException ex)
        {
            var result = await ErrorFactory.FromApiExceptionAsync(ex, "FailedToLoadDashboard");
            Snackbar.Add(result.Errors.First().Description, Severity.Error);
        }

        try
        {
            if (Dashboards.Select(x => x.Id).Contains(CurrentDashboard?.Id))
            {
                Logger.LogInformation("Dashboard still exists");
            }
            else
            {
                CurrentDashboard = Dashboards.First();
            }

            Grids = [];

            foreach(var dash in Dashboards)
            {
                var details = await DashboardIntegrationService.GetDashboardDisplayAsync(dash!.Id);

                Grids.Add(new GridDashboardConfiguration(
                    details.Configuration.Rows, 
                    details.Configuration.Columns, 
                    details.Configuration.PositionedWidgets, 
                    details.Configuration.CalculatedWidgets, 
                    dash.Id));
            }

            CurrentConfiguration = Grids.Where(x => x.Id == CurrentDashboard!.Id).First();
            StateHasChanged();
            _failedToLoad = false;
        }
        catch (Refit.ApiException ex)
        {
            var result = await ErrorFactory.FromApiExceptionAsync(ex, "FailedToLoadDashboard");
            Snackbar.Add(result.Errors.First().Description, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load dashboard", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LiveUpdate(UpdateEvent updateEvent)
    {
        if (updateEvent.Type != UpdateType.WidgetsActionUpdate)
            return;

        await LiteRefresh();
    }

    private async Task LiteRefresh()
    {
        try
        {
            Grids = [];

            foreach (var dash in Dashboards)
            {
                var details = await DashboardIntegrationService.GetDashboardDisplayAsync(dash!.Id);

                Grids.Add(new GridDashboardConfiguration(
                    details.Configuration.Rows,
                    details.Configuration.Columns,
                    details.Configuration.PositionedWidgets,
                    details.Configuration.CalculatedWidgets,
                    dash.Id));
            }

            CurrentConfiguration = Grids.Where(x => x.Id == CurrentDashboard!.Id).First();
            StateHasChanged();
            _failedToLoad = false;
        }
        catch (Refit.ApiException ex)
        {
            var result = await ErrorFactory.FromApiExceptionAsync(ex, "FailedToLoadDashboard");
            Snackbar.Add(result.Errors.First().Description, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to refresh dashboard", Severity.Error);
        }
    }

    public void Dispose()
    {
        LiveUpdateService.OnUpdate -= LiveUpdate;
    }
}
