@page "/devices/details/{Id}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Refit
@using Senswave.Web.Components.Devices
@using Senswave.Web.Devices.Integration
@using Senswave.Web.Devices.Models
@using Senswave.Web.Devices.Components
@using Senswave.Web.Devices.Services
@using Senswave.Web.Homes.Integration
@using Senswave.Web.Homes.Services
@using Senswave.Web.Shared.Components
@using Senswave.Web.Shared.Resulting

@inject IOperationIntegrationService OperationIntegrationService
@inject IWidgetIntegrationService WidgetIntegrationService
@inject IDashboardIntegrationService DashboardIntegrationService
@inject IDeviceDetailsService DeviceService
@inject IRoomService RoomService
@inject IHomeService HomeService
@inject ISnackbar Snackbar
@inject ILogger<AddDeviceDialog> Logger
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IErrorFactory ErrorFactory

<PageTitle>@PageName()</PageTitle>

<SensPage Loading="@_loading" FailedToLoad="@_failedToLoad" RefreshContent="@RefreshPage" Breadcrumbs="@Breadcrumbs">
    <LoadingContent>

        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="d-flex flex-column">
            <MudGrid Spacing="0" Class="p-0 d-flex flex-row flex-wrap">
                <MudItem xs="12" md="6">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:256px;" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:256px;" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:256px;" />
                </MudItem>
            </MudGrid>
        </MudContainer>

    </LoadingContent>
    <Content>
        <MudContainer MaxWidth="MaxWidth.Large" Gutters="false" Class="d-flex flex-column gap-3 pb-3">

            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h5" HtmlTag="h1">Configure @PageName()</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @OperationGroups.Count operation(s) · @Dashboards.Count screen(s)
                    </MudText>
                </div>

                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Text"
                               StartIcon="@Icons.Material.Rounded.SpaceDashboard"
                               Href="@($"/devices/dashboard/{Id}")">
                        Open controls
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Rounded.Check"
                               Disabled="@(!HasChanges())"
                               OnClick="SaveChanges">
                        Save
                    </MudButton>
                </div>
            </div>

            <MudTabs Class="sens-tabs" Elevation="0" Border="false" Rounded="false" Color="Color.Transparent" SliderColor="Color.Primary" KeepPanelsAlive="true">

                <MudTabPanel Text="General">
                    <div class="d-flex flex-column gap-4 pt-4" style="max-width: 720px;">
                        <MudPaper Outlined="true" Class="pa-4 rounded-lg">
                            <DeviceForm @ref="DeviceForm"
                                        Model="DeviceModel"
                                        Operations="@Operations"
                                        Rooms="@Rooms"
                                        Edit="true"
                                        OnChange="StateHasChanged" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3 d-block">
                                Tile type and tile operation decide what the device tile shows on the dashboard. A Switch tile needs a Boolean operation.
                            </MudText>
                        </MudPaper>

                        <MudPaper Outlined="true" Class="pa-4 rounded-lg" Style="border-color: var(--mud-palette-error);">
                            <div class="d-flex flex-wrap align-center gap-3">
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Error">Delete device</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Removes its operations, widgets and screens. This cannot be undone.</MudText>
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteDevice">Delete device</MudButton>
                            </div>
                        </MudPaper>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@($"Operations ({OperationGroups.Count})")">
                    <div class="d-flex flex-column gap-3 pt-4" style="max-width: 900px;">
                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                                An operation is an MQTT topic with a value type. Widgets are the controls that show or change it.
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Rounded.Add"
                                       OnClick="AddOperation">
                                Operation
                            </MudButton>
                        </div>

                        @if (OperationGroups.Count == 0)
                        {
                            <MudPaper Outlined="true" Class="pa-6 rounded-lg d-flex flex-column align-center gap-1">
                                <MudText Typo="Typo.subtitle1">No operations yet</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Add an operation for each value the device sends or accepts.</MudText>
                            </MudPaper>
                        }

                        @foreach (var group in OperationGroups)
                        {
                            <MudPaper Outlined="true" Class="rounded-lg overflow-hidden">
                                <div class="d-flex flex-wrap align-center gap-2 px-4 py-2" style="background-color: var(--mud-palette-action-default-hover);">
                                    <MudText Typo="Typo.subtitle1">@group.Operation.Name</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@group.Operation.Type</MudChip>
                                    @if (group.Operation.Id == DeviceModel.TileOperationId)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Dashboard tile</MudChip>
                                    }
                                    <MudSpacer />
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Rounded.Add"
                                               OnClick="() => AddWidget(group.Operation)">
                                        Widget
                                    </MudButton>
                                    <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" AriaLabel="@($"{group.Operation.Name} options")">
                                        <MudMenuItem Icon="@Icons.Material.Rounded.Delete"
                                                     IconColor="Color.Error"
                                                     Disabled="@(group.Widgets.Count != 0)"
                                                     OnClick="@(() => DeleteOperation(group.Operation.Id))">
                                            @(group.Widgets.Count == 0 ? "Delete operation" : "Delete its widgets first")
                                        </MudMenuItem>
                                    </MudMenu>
                                </div>

                                <div class="px-4 py-1">
                                    @if (group.Widgets.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary py-2">No widgets. Add one to control this operation from a screen.</MudText>
                                    }
                                    @foreach (var widget in group.Widgets)
                                    {
                                        <div class="d-flex align-center gap-2 py-1">
                                            <MudChip T="string" Size="Size.Small">@widget.Type</MudChip>
                                            <MudText Typo="Typo.body2" Class="flex-grow-1">@widget.Name</MudText>
                                            <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                                           Size="Size.Small"
                                                           aria-label="@($"Delete widget {widget.Name}")"
                                                           OnClick="@(() => DeleteWidget(widget.Id))" />
                                        </div>
                                    }
                                </div>
                            </MudPaper>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="@($"Screens ({Dashboards.Count})")">
                    <div class="d-flex flex-column gap-3 pt-4" style="max-width: 720px;">
                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary flex-grow-1">
                                Screens hold the widgets you see when you open the device. Up to 3 per device.
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Rounded.Add"
                                       Disabled="@(Dashboards.Count >= 3)"
                                       OnClick="AddDashboard">
                                Screen
                            </MudButton>
                        </div>

                        @if (Dashboards.Count == 0)
                        {
                            <MudPaper Outlined="true" Class="pa-6 rounded-lg d-flex flex-column align-center gap-1">
                                <MudText Typo="Typo.subtitle1">No screens yet</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Add a screen, then place widgets on it from Open controls.</MudText>
                            </MudPaper>
                        }

                        @foreach (var dashboard in Dashboards)
                        {
                            <MudPaper Outlined="true" Class="pa-3 rounded-lg d-flex flex-wrap align-center gap-3">
                                <MudTextField T="string"
                                              Label="Name"
                                              Value="@dashboard.Name"
                                              ValueChanged="@(v => OnDashboardNameChanged(dashboard, v))"
                                              Immediate="true"
                                              Class="flex-grow-1"
                                              Style="min-width: 160px;" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@dashboard.Rows × @dashboard.Columns grid</MudText>
                                @if (dashboard.IsDirty)
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => UpdateDashboard(dashboard))">
                                        Save name
                                    </MudButton>
                                }
                                <MudIconButton Icon="@Icons.Material.Rounded.Delete"
                                               aria-label="@($"Delete screen {dashboard.Name}")"
                                               OnClick="@(() => DeleteDashboard(dashboard))" />
                            </MudPaper>
                        }
                    </div>
                </MudTabPanel>

            </MudTabs>
        </MudContainer>
    </Content>
</SensPage>

@code {
    private List<BreadcrumbItem> Breadcrumbs => [
        new("Dashboard", "/devices", false, $"{Icons.Material.Filled.Dashboard}"),
        new($"{PageName()}", $"/devices/dashboard/{Id}", false, $"{Icons.Material.Filled.PermDeviceInformation}"),
        new("Configure", $"/devices/details/{Id}", false, $"{Icons.Material.Filled.Tune}")
    ];

    private string PageName() => DeviceModel?.Name ?? "Device";

    private bool _loading = true;
    private bool _failedToLoad = true;

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private DeviceForm? DeviceForm;

    private DeviceModel ReferenceModel = new();

    private DeviceModel DeviceModel = new();

    public List<RoomDto> Rooms = [];

    public List<OperationDto> Operations = [];

    public List<DisplayGroupDto> OperationGroups = [];

    private class EditableDashboard
    {
        public string Id { get; set; } = string.Empty;

        public string Name { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;

        public string OriginalName { get; set; } = string.Empty;
        public string OriginalIcon { get; set; } = string.Empty;

        public int Rows { get; set; }
        public int Columns { get; set; }

        public bool IsDirty =>
            Name != OriginalName || Icon != OriginalIcon;
    }

    private List<EditableDashboard> Dashboards = [];

    protected override async Task OnInitializedAsync()
    {
        await RefreshPage();
    }

    private bool HasChanges()
    {
        if (ReferenceModel.Name != DeviceModel.Name)
            return true;

        if (ReferenceModel.Icon != DeviceModel.Icon)
            return true;

        if (ReferenceModel.TileOperationId != DeviceModel.TileOperationId)
            return true;

        if (ReferenceModel.TileType != DeviceModel.TileType)
            return true;

        if (ReferenceModel.RoomId != DeviceModel.RoomId)
            return true;

        return false;
    }

    private async Task RefreshPage()
    {
        _loading = true;
        try
        {
            // Rooms belong to the current home, which is not loaded yet when the page is opened directly.
            await HomeService.Initialize();

            Rooms = [];
            Rooms.Add(new(null, "No Room"));
            await RoomService.LoadRooms();
            var rooms = RoomService.Rooms;
            rooms.ForEach((r) => { Rooms.Add(r); });

            var deviceResult = await DeviceService.GetDevice(Id);

            if (deviceResult.IsFailure)
            {
                Snackbar.Add($"Failed to load device.", Severity.Error);
                return;
            }
            deviceResult.Value.TileType = deviceResult.Value.TileType is null ? "Default" : deviceResult.Value.TileType;
            ReferenceModel = deviceResult.Value;
            DeviceModel = new DeviceModel
            {
                Id = Id,
                HomeId = deviceResult.Value.HomeId,
                Icon = deviceResult.Value.Icon,
                RoomId = deviceResult.Value.RoomId,
                Name = deviceResult.Value.Name,

                TileOperationId = deviceResult.Value.TileOperationId,
                TileType = deviceResult.Value.TileType,
            };

            var response = await DeviceService.GetWidgetsAndOperations(Id);

            if (deviceResult.IsFailure)
            {
                Snackbar.Add($"Failed to load widgets and operations.", Severity.Error);
                return;
            }

            OperationGroups = response.Value;

            var responseDashboards = await DeviceService.GetDashboards(Id);

            if (deviceResult.IsFailure)
            {
                Snackbar.Add($"Failed to load dashboards.", Severity.Error);
                return;
            }

            Dashboards = responseDashboards.Value.Select(d => new EditableDashboard
            {
                Id = d.Id,
                Name = d.Name,
                Icon = d.Icon,
                OriginalName = d.Name,
                OriginalIcon = d.Icon,

                Rows = d.Rows,
                Columns = d.Columns
            })
            .ToList();

            try
            {
                var operationResponse = await OperationIntegrationService.DisplayOperationsAsync(Id, 1, 100);

                Operations = operationResponse.Items;
            }
            catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Operations = [];
            }

            _failedToLoad = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load device: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveChanges()
    {
        if (DeviceForm is null)
            return;

        var valid = await DeviceForm.Validate();
        if (!valid)
            return;

        try
        {
            _loading = true;
            StateHasChanged();

            var result = await DeviceService.UpdateDevice(DeviceModel);

            if (result.IsFailure)
            {
                Snackbar.Add(result.Errors.First().Description, Severity.Error);
                return;    
            }

            await RefreshPage();
            Snackbar.Add("Device updated", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to update device", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteDevice()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            "Are you sure to delete this device?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        if (confirm != true)
            return;

        _loading = true;
        StateHasChanged();
        var result = await DeviceService.DeleteDevice(DeviceModel.Id);

        if (result.IsFailure)
        {
            Snackbar.Add(result.Errors.First().Description, Severity.Error);
            return;
        }

        Snackbar.Add("Device deleted", Severity.Success);
        Navigation.NavigateTo("/devices");
    }

    private async Task AddOperation()
    {
        var parameters = new DialogParameters
        {
            ["DeviceId"] = Id
        };

        var dialog = await DialogService.ShowAsync<AddOperationDialog>("Create Operation",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            _loading = true;
            StateHasChanged();
            await RefreshPage();
        }
    }

    private async Task DeleteOperation(string id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            "Are you sure to delete this operation?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        if (confirm != true)
            return;

        try
        {
            _loading = true;
            StateHasChanged();

            await OperationIntegrationService.DeleteOperationAsync(id);
            Snackbar.Add("Operation removed.", Severity.Success);

            await RefreshPage();
        }
        catch (ApiException ex)
        {
            var operation = await ErrorFactory.FromApiExceptionAsync(ex, "FailedToDeleteOperation");
            Snackbar.Add(operation.Errors.First().Description, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddWidget(DisplayOperationDto operation)
    {
        var parameters = new DialogParameters
        {
            ["OperationId"] = operation.Id
        };

        var dialog = await DialogService.ShowAsync<AddWidgetDialog>("Create Widget",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            _loading = true;
            StateHasChanged();
            await RefreshPage();
        }
    }

    private async Task DeleteWidget(string id)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            "Are you sure to delete this widget?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions
           {
               MaxWidth = MaxWidth.Medium,
               FullWidth = true,
               CloseOnEscapeKey = true
           });

        if (confirm != true)
            return;

        try 
        {
            _loading = true;
            StateHasChanged();

            await WidgetIntegrationService.DeleteWidgetAsync(id);
            Snackbar.Add("Widget removed.", Severity.Success);
            await RefreshPage();
        }
        catch (ApiException ex)
        {
            var operation = await ErrorFactory.FromApiExceptionAsync(ex, "FailedToDeleteWidget");
            Snackbar.Add(operation.Errors.First().Description, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddDashboard()
    {
        var parameters = new DialogParameters
            {
                ["DeviceId"] = Id
            };

        var dialog = await DialogService.ShowAsync<AddDashboardDialog>("Create screen",
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            _loading = true;
            StateHasChanged();
            await RefreshPage();
        }
    }

    private async Task DeleteDashboard(EditableDashboard dto)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
           "Confirm",
           "Are you sure to delete this dashboard?",
           yesText: "Delete",
           cancelText: "Cancel",
           options: new DialogOptions
           {
               MaxWidth = MaxWidth.Medium,
               FullWidth = true,
               CloseOnEscapeKey = true
           });

        if (confirm != true)
            return;

        try
        {
            _loading = true;
            StateHasChanged();

            await DashboardIntegrationService.DeleteDashboardAsync(dto.Id);
            await RefreshPage();
            Snackbar.Add("Dashboard removed", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to remove dashboard", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UpdateDashboard(EditableDashboard dto)
    {
        try
        {
            _loading = true;

            var request = new UpdateDashboardRequest(dto.Name, dto.Icon);

            await DashboardIntegrationService.UpdateDashboardAsync(dto.Id, request);
            await RefreshPage();
            Snackbar.Add("Dashboard updated", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to update dashboard", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnDashboardNameChanged(EditableDashboard dashboard, string value)
    {
        dashboard.Name = value;
    }
}
