@page "/datasources"
@attribute [Authorize]
@using Senswave.Web.DataSources.Components
@using Senswave.Web.DataSources.Integration
@using Senswave.Web.DataSources.Models
@using Senswave.Web.DataSources.Services
@using Senswave.Web.Homes.Services
@using Senswave.Web.Shared.Components

@inject ILogger<List> Logger
@inject IBrokerService BrokerService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Data Sources</PageTitle>

<SensPage Loading="@_loading" FailedToLoad="@_failedToLoad" RefreshContent="@RefreshPage" Breadcrumbs="@Breadcrumbs">
    <LoadingContent>
        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="d-flex flex-column">
            <MudContainer xs="12" MaxWidth="MaxWidth.False" Gutters="false" Class="m-1">
                <MudSkeleton Width="256px" />
            </MudContainer>
            <MudGrid Spacing="0" Class="p-0 d-flex flex-row flex-wrap">
                <MudItem xs="12" sm="6" md="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;" />
                </MudItem>
                <MudItem xs="12" sm="6" md="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </LoadingContent>
    <Content>
        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="d-flex flex-column gap-3 pb-3">

            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h5" HtmlTag="h1">Data sources</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">MQTT brokers that carry data between Senswave and your devices.</MudText>
                </div>
                <div class="d-flex align-center gap-2 no-print">
                    <MudTooltip Text="Refresh">
                        <MudIconButton Icon="@Icons.Material.Rounded.Refresh" aria-label="Refresh data sources" OnClick="RefreshPage" />
                    </MudTooltip>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Rounded.Add"
                               OnClick="AddDataSourceHandler">
                        Data source
                    </MudButton>
                </div>
            </div>

            <MudGrid Spacing="3" Class="p-0 d-flex flex-row flex-wrap">

                @foreach (var broker in brokers)
                {
                    <MudItem xs="12" sm="12" md="6" lg="4" xl="3" xxl="3">
                        <SensDataSource Broker="@broker" OnClick="() => DataSourceSelected(broker.Id)" />
                    </MudItem>
                }

                <MudItem xs="12" sm="6" md="6" lg="4" xl="3" xxl="3" Class="no-print">
                    <SensListAction Title="Add data source" OnClick="AddDataSourceHandler" />
                </MudItem>

            </MudGrid>
        </MudContainer>
    </Content>
</SensPage>

@code {
    private bool _loading = true;
    private bool _failedToLoad = true;

    private List<BrokerDto> brokers = [];

    private List<BreadcrumbItem> Breadcrumbs => [
        new("Data sources", "/datasources", false, $"{Icons.Material.Filled.Hub}")
    ];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await RefreshPage();
    }

    private async Task AddDataSourceHandler()
    {
        var dialog = await DialogService.ShowAsync<AddBrokerDialog>(
            "Create Broker",
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await RefreshPage();
        }

    }

    private async Task DataSourceSelected(string id)
    {
        Navigation.NavigateTo($"/datasources/details/{id}");
    }

    private async Task RefreshPage()
    {
        try
        {
            _loading = true;

            var result = await BrokerService.GetBrokers();

            if (result.IsFailure)
            {
                _failedToLoad = true;
                return;
            }

            brokers = result.Value;
            _failedToLoad = false;

        }
        catch (Exception ex)
        {
            _failedToLoad = true;
            Logger.LogError(ex, "Failed to load page.");
        }
        finally
        {
            _loading = false;
        }
    }
}
