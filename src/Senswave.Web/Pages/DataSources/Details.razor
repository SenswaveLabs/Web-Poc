@page "/datasources/details/{Id}"
@attribute [Authorize]

@using Senswave.Web.DataSources.Components
@using Senswave.Web.DataSources.Integration
@using Senswave.Web.DataSources.Models
@using Senswave.Web.DataSources.Services
@using Senswave.Web.Services
@using Senswave.Web.Shared.Components

@inject IBrokerIntegrationService BrokerIntegrationService
@inject IBrokerService BrokerService
@inject ISnackbar Snackbar
@inject ILogger<Details> Logger
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>@PageName()</PageTitle>

<SensPage Loading="@_loading" FailedToLoad="@_failedToLoad" RefreshContent="@RefreshPage" Breadcrumbs="@Breadcrumbs">
    <LoadingContent>

        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="d-flex flex-column">
            <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="m-1">
                <MudSkeleton Width="256px" />
            </MudContainer>
            <MudGrid Spacing="0" Class="p-0 d-flex flex-row flex-wrap">
                <MudItem xs="12" md="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:192px;"  />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:384px;" />
                </MudItem>
            </MudGrid>
        </MudContainer>
        
    </LoadingContent>
    <Content>
        <MudContainer MaxWidth="MaxWidth.Large" Gutters="false" Class="d-flex flex-column gap-3 pb-3">

            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h5" HtmlTag="h1">@PageName()</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        MQTT broker · belongs only to your account, do not share its credentials
                    </MudText>
                </div>

                <div class="d-flex align-center gap-2">
                    <MudTooltip Text="Refresh">
                        <MudIconButton Icon="@Icons.Material.Rounded.Refresh" aria-label="Refresh" OnClick="RefreshPage" />
                    </MudTooltip>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Rounded.Check"
                               Disabled="@(!HasChanges())"
                               OnClick="SaveChanges">
                        Save
                    </MudButton>
                </div>
            </div>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudStack Spacing="3">
                        <SensDataSourceState ConnectionStatus="@ConnectionState" Name="@EditableModel.Name" Port="@EditableModel.Port" Server="@EditableModel.Url">
                            <Actions>
                                @if (IsRunning)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Rounded.Refresh"
                                               OnClick="OnRestart">
                                        Restart
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Rounded.PlayArrow"
                                               OnClick="OnStart"
                                               Disabled="@(ConnectionState == "Loading")">
                                        Start client
                                    </MudButton>
                                }
                            </Actions>
                        </SensDataSourceState>

                        <MudPaper Outlined="true" Class="pa-4 rounded-lg" Style="border-color: var(--mud-palette-error);">
                            <MudStack Spacing="3">
                                @if (IsRunning)
                                {
                                    <div class="d-flex flex-wrap align-center gap-3">
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.subtitle1" Color="Color.Error">Stop client</MudText>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Devices in homes using this source stop receiving commands.</MudText>
                                        </div>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Stop" OnClick="OnStop">Stop</MudButton>
                                    </div>
                                    <MudDivider />
                                }
                                <div class="d-flex flex-wrap align-center gap-3">
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.subtitle1" Color="Color.Error">Delete data source</MudText>
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Homes linked to it lose their connection. This cannot be undone.</MudText>
                                    </div>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteDataSource">Delete</MudButton>
                                </div>
                            </MudStack>
                        </MudPaper>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-4 rounded-lg">
                        <MudText Typo="Typo.subtitle1">Connection</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">Only the name can be changed. Create a new data source to use another broker.</MudText>
                        <BrokerForm @ref="_form" Model="EditableModel" Edit="true" NameChanged="@(_ => StateHasChanged())" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

        </MudContainer>
    </Content>
</SensPage>

@code {

    private bool _loading = true;
    private bool _failedToLoad = true;

    private BrokerForm? _form;

    [Parameter] 
    public string Id { get; set; }

    private BrokerDetailedModel BaseModel { get; set; } = new();

    private BrokerDetailedModel EditableModel { get; set; } = new();

    private string ConnectionState = "Loading";

    private bool IsRunning => ConnectionState is "Working" or "Restarting";

    private List<BreadcrumbItem> Breadcrumbs => [
        new("Data sources", "/datasources", false, $"{Icons.Material.Filled.Hub}"),
        new($"{PageName()}", $"/datasources/details/{Id}", false, $"{Icons.Material.Filled.DeviceHub}")
    ];

    protected async override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await RefreshPage();
    }

    private async Task RefreshPage()
    {
        try
        {
            _loading = true;

            var result = await BrokerIntegrationService.GetClientStateAsync(Id);

            ConnectionState = result.ConnectionStatus;

            var brokerResult = await BrokerService.GetBroker(Id);

            EditableModel = new BrokerDetailedModel
            {
                Name = brokerResult.Value.Name,

                ClientName = brokerResult.Value.ClientName,
                Url = brokerResult.Value.Url,
                Port = brokerResult.Value.Port,
                ProtocolVersion = brokerResult.Value.ProtocolVersion,
                UseTls = brokerResult.Value.UseTls,
            };

            BaseModel = new BrokerDetailedModel
            {
                Name = brokerResult.Value.Name,

                ClientName = brokerResult.Value.ClientName,
                Url = brokerResult.Value.Url,
                Port = brokerResult.Value.Port,
                ProtocolVersion = brokerResult.Value.ProtocolVersion,
                UseTls = brokerResult.Value.UseTls,
            };

            _failedToLoad = false;
        }
        catch (Exception ex)
        {
            _failedToLoad = true;
            Logger.LogError(ex, "Failed to load page.");
        }
        finally
        {
            _loading = false;
        }
    }

    private bool HasChanges() => EditableModel.Name != BaseModel.Name;

    private string PageName() => BaseModel is null ? "Data Source" : BaseModel.Name;

    private async Task SaveChanges()
    {
        _loading = true;
        try
        {
            var result = await BrokerService.UpdateBroker(Id, EditableModel.Name);

            if (result.IsSuccess)
                Snackbar.Add("Name updated.", Severity.Success);
            else
                Snackbar.Add(result.Errors.FirstOrDefault()?.Description ?? "Failed to udpate.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStart()
    {
        var dialog = await DialogService.ShowAsync<RequestCredentialsDialog>(
            "Broker Credentials",
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var credentials = (RequestCredentialsDialog.BrokerCredentials) result.Data;

            var username = credentials.Username;
            var password = credentials.Password;

            _loading = true;
            try
            {
                StateHasChanged();
                var startResult = await BrokerService.StartClient(Id, username, password);

                if (startResult.IsFailure)
                    Snackbar.Add(startResult.Errors.FirstOrDefault()?.Description ?? "Operation failed.", Severity.Error);

                await RefreshPage();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to start connection.");
                Snackbar.Add("Operation failed.", Severity.Error);
            }
            finally
            {
                _loading = false;
            }
        }
    }

    private async Task DeleteDataSource()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            "Delete data source?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm != true)
            return;

        _loading = true;

        try
        {
            var result = await BrokerService.DeleteBroker(Id);

            if (result.IsFailure)
            {
                Snackbar.Add(result.Errors.FirstOrDefault()?.Description ?? "Operation failed.", Severity.Error);
                return;
            }

            Navigation.NavigateTo("/datasources");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");
            Snackbar.Add("Operation failed.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStop()
    {
        _loading = true;
        try
        {
            var result = await BrokerService.StopClient(Id);

            if (result.IsFailure)
                Snackbar.Add(result.Errors.FirstOrDefault()?.Description ?? "Operation failed.", Severity.Error);

            await RefreshPage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");
            Snackbar.Add("Operation failed.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRestart()
    {
        _loading = true;
        try
        {
            var result = await BrokerService.RestartClient(Id);

            if (result.IsFailure)
                Snackbar.Add(result.Errors.FirstOrDefault()?.Description ?? "Operation failed.", Severity.Error);

            await RefreshPage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Operation failed");
            Snackbar.Add("Operation failed.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}