@page "/auth/forgot-password"

@using Senswave.Web.Components.Auth
@using Senswave.Web.Shared.Services
@using Senswave.Web.Users.Auth.Models
@using Senswave.Web.Users.Auth.Services

@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILoadingService LoadingService

<PageTitle>Reset password - Senswave</PageTitle>

<AuthShell @ref="_shell" Title="@(_codeSent ? "Enter reset code" : "Reset password")">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert>
    }

    @if (!_codeSent)
    {
        <MudText Typo="Typo.body2" Class="mb-4">
            Enter your account email. We'll send you a code to set a new password.
        </MudText>

        <MudForm @ref="_emailForm">
            <MudTextField @bind-Value="_email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="Email is required."
                          Validation="@(new Func<string, string?>(EmailRules.Validate))"
                          FullWidth="true"
                          UserAttributes="@(new() { ["autocomplete"] = "email" })"
                          Class="mb-4" />

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Disabled="LoadingService.Loading"
                       OnClick="SendCode"
                       Class="mb-3">
                Send code
            </MudButton>
        </MudForm>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-4">
            If an account exists for <strong>@_email</strong>, we sent a reset code to it. The code is valid for a limited time.
        </MudText>

        <MudForm @ref="_resetForm">
            <MudTextField @bind-Value="_code"
                          Label="Reset code"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Code is required."
                          FullWidth="true"
                          UserAttributes="@(new() { ["autocomplete"] = "one-time-code" })"
                          Class="mb-2" />

            <MudTextField @bind-Value="_password"
                          Label="New password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Password is required."
                          Validation="@(new Func<string, IEnumerable<string>>(PasswordRules.Validate))"
                          HelperText="@PasswordRules.Description"
                          FullWidth="true"
                          UserAttributes="@(new() { ["autocomplete"] = "new-password" })"
                          Class="mb-2" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirm new password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Confirm your password."
                          Validation="@(new Func<string, string?>(MatchesPassword))"
                          FullWidth="true"
                          UserAttributes="@(new() { ["autocomplete"] = "new-password" })"
                          Class="mb-4" />

            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Disabled="LoadingService.Loading"
                       OnClick="ResetPassword"
                       Class="mb-2">
                Set new password
            </MudButton>

            <div class="d-flex justify-space-between align-center flex-wrap">
                <ResendButton Text="Resend code" StartCooldown="true" OnResend="ResendCode" />
                <MudButton Variant="Variant.Text" OnClick="UseDifferentEmail">Use a different email</MudButton>
            </div>
        </MudForm>
    }

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.body2" Align="Align.Center">
        Remembered it?
        <MudLink Href="/auth/login" Typo="Typo.body2">Back to sign in</MudLink>
    </MudText>
</AuthShell>

@code {
    private const string SyncKey = "Auth:ForgotPassword";

    private AuthShell? _shell;

    private MudForm? _emailForm;

    private MudForm? _resetForm;

    private string _email = string.Empty;

    private string _code = string.Empty;

    private string _password = string.Empty;

    private string _confirmPassword = string.Empty;

    private string? _error;

    private bool _codeSent;

    private string? MatchesPassword(string value) =>
        value == _password ? null : "Passwords don't match.";

    private async Task SendCode()
    {
        _error = null;

        await _emailForm!.Validate();

        if (!_emailForm.IsValid)
            return;

        try
        {
            LoadingService.Show(SyncKey);

            var result = await AccountService.ForgotPassword(_email);

            if (result.IsFailure)
            {
                _error = "Couldn't send the code. Please try again later.";
                return;
            }

            _codeSent = true;
        }
        finally
        {
            LoadingService.Hide(SyncKey);
        }

        StateHasChanged();
        await _shell!.FocusHeading();
    }

    private async Task ResetPassword()
    {
        _error = null;

        await _resetForm!.Validate();

        if (!_resetForm.IsValid)
            return;

        try
        {
            LoadingService.Show(SyncKey);

            var result = await AccountService.ResetPassword(_email, _code, _password);

            if (result.IsFailure)
            {
                var error = result.Errors[0];

                _error = error.Code switch
                {
                    "InvalidToken" => "The code is invalid or has expired. Request a new one.",
                    var code when code.StartsWith("Password") => error.Description,
                    _ => "Couldn't reset the password. Please try again later."
                };
                return;
            }

            Navigation.NavigateTo("/auth/login?passwordReset=true");
        }
        finally
        {
            LoadingService.Hide(SyncKey);
        }
    }

    private async Task<bool> ResendCode()
    {
        var result = await AccountService.ForgotPassword(_email);

        if (result.IsFailure)
        {
            Snackbar.Add("Couldn't send the code. Please try again.", Severity.Error);
            return false;
        }

        Snackbar.Add("If the account exists, we sent a new code.", Severity.Info);
        return true;
    }

    private async Task UseDifferentEmail()
    {
        _codeSent = false;
        _error = null;
        _code = _password = _confirmPassword = string.Empty;

        StateHasChanged();
        await _shell!.FocusHeading();
    }
}
