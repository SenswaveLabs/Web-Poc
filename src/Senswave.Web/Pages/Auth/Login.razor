@page "/login"
@page "/auth/login"

@using Senswave.Web.Components.Auth
@using Senswave.Web.Shared.Services
@using Senswave.Web.Users.Auth.Models
@using Senswave.Web.Users.Auth.Services
@using Senswave.Web.Users.Users.Services

@inject IAuthenticationService AuthService
@inject IAccountService AccountService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILoadingService LoadingService
@inject IUserService UserService

<PageTitle>Sign in - Senswave</PageTitle>

<AuthShell Title="Sign in">
    @if (_alert is not null)
    {
        <MudAlert Severity="_alert.Severity" Class="mb-4" role="alert">
            @_alert.Message
            @if (_alert.OfferResend)
            {
                <div class="mt-2">
                    <ResendButton Text="Resend confirmation email" OnResend="ResendConfirmation" />
                </div>
            }
        </MudAlert>
    }

    <MudForm @ref="_form">
        <MudTextField @bind-Value="_model.Username"
                      Label="Email"
                      Variant="Variant.Outlined"
                      InputType="InputType.Email"
                      Required="true"
                      RequiredError="Email is required."
                      Validation="@(new Func<string, string?>(EmailRules.Validate))"
                      FullWidth="true"
                      UserAttributes="@(new() { ["autocomplete"] = "email" })"
                      Class="mb-2" />

        <MudTextField @bind-Value="_model.Password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Required="true"
                      RequiredError="Password is required."
                      FullWidth="true"
                      UserAttributes="@(new() { ["autocomplete"] = "current-password" })"
                      OnKeyDown="SubmitOnEnter"
                      Class="mb-1" />

        <div class="d-flex align-center justify-space-between flex-wrap mb-3">
            <MudCheckBox @bind-Value="_model.RememberMe" Color="Color.Primary">Remember me</MudCheckBox>
            <MudLink Href="/auth/forgot-password" Typo="Typo.body2">Forgot password?</MudLink>
        </div>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   FullWidth="true"
                   Disabled="LoadingService.Loading"
                   OnClick="HandleLogin"
                   Class="mb-3">
            Sign in
        </MudButton>

        <GoogleSignInButton />

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.body2" Align="Align.Center">
            Don't have an account?
            <MudLink Href="/auth/register" Typo="Typo.body2">Create one</MudLink>
        </MudText>
    </MudForm>
</AuthShell>

@code {
    private const string SyncKey = "Auth:Login";

    [SupplyParameterFromQuery]
    public bool? EmailConfirmed { get; set; }

    [SupplyParameterFromQuery]
    public bool? PasswordReset { get; set; }

    private MudForm? _form;

    private LoginWithPasswordModel _model = new();

    private LoginAlert? _alert;

    private record LoginAlert(Severity Severity, string Message, bool OfferResend = false);

    protected override void OnParametersSet()
    {
        _alert = (EmailConfirmed, PasswordReset) switch
        {
            (true, _) => new(Severity.Success, "Email confirmed. You can sign in now."),
            (false, _) => new(Severity.Error, "The confirmation link is invalid or has expired. Enter your email and request a new one.", OfferResend: true),
            (_, true) => new(Severity.Success, "Password changed. Sign in with your new password."),
            _ => _alert
        };
    }

    private async Task SubmitOnEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleLogin();
    }

    private async Task HandleLogin()
    {
        await _form!.Validate();

        if (!_form.IsValid)
            return;

        // Read the target before signing in: the auth shell may already leave this page once the state changes.
        var returnUrl = AuthRedirect.SafeReturnUrl(Navigation);

        try
        {
            LoadingService.Show(SyncKey);

            var result = await AuthService.Login(_model);

            if (result.IsFailure)
            {
                _alert = result.Errors[0].Code switch
                {
                    AuthErrorCodes.EmailNotConfirmed => new(Severity.Warning, "Your email is not confirmed yet. Check your inbox or request a new link.", OfferResend: true),
                    AuthErrorCodes.LockedOut => new(Severity.Error, "Too many failed attempts. Try again in a minute."),
                    AuthErrorCodes.InvalidCredentials => new(Severity.Error, "Incorrect email or password."),
                    _ => new(Severity.Error, "Sign in failed. Please try again later.")
                };
                return;
            }

            await UserService.Initialize();

            Navigation.NavigateTo(returnUrl);
        }
        finally
        {
            LoadingService.Hide(SyncKey);
        }
    }

    private async Task<bool> ResendConfirmation()
    {
        if (string.IsNullOrWhiteSpace(_model.Username))
        {
            Snackbar.Add("Enter your email first.", Severity.Warning);
            return false;
        }

        var result = await AccountService.ResendConfirmationEmail(_model.Username);

        if (result.IsFailure)
        {
            Snackbar.Add("Couldn't send the email. Please try again.", Severity.Error);
            return false;
        }

        Snackbar.Add("If the account exists and is not confirmed, we sent a new link.", Severity.Info);
        return true;
    }
}
