@page "/homes/details"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Refit
@using Senswave.Web.DataSources.Components
@using Senswave.Web.DataSources.Services
@using Senswave.Web.Homes.Models
@using Senswave.Web.Homes.Services
@using Senswave.Web.Homes.Integration
@using Senswave.Web.DataSources.Integration
@using Senswave.Web.Shared.Components
@using Senswave.Web.Shared.Extensions
@using Senswave.Web.Homes.Components
@using Senswave.Web.Users.Users.Services

@inject IBrokerService BrokerService
@inject IHomeService HomeService
@inject IHomesIntegrationService HomesIntegrationService
@inject IHomesSharingIntegrationService SharingIntegrationService
@inject IBrokerIntegrationService BrokerIntegrationService
@inject ILogger<Details> Logger
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserService UserService

<PageTitle>@PageName()</PageTitle>

<SensPage Loading="@_loading" FailedToLoad="@_failedToLoad" RefreshContent="@RefreshPage" Breadcrumbs="@Breadcrumbs">
    <LoadingContent>

        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="d-flex flex-column">
            <MudGrid Spacing="0" Class="p-0 d-flex flex-row flex-wrap">
                <MudItem xs="12" md="6">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:256px;" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:256px;" />
                </MudItem>
            </MudGrid>
        </MudContainer>

    </LoadingContent>
    <Content>
        <MudContainer MaxWidth="MaxWidth.Large" Gutters="false" Class="d-flex flex-column gap-3 pb-3">

            <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                <div class="d-flex align-center gap-3">
                    <SensIcon Icon="@(Current?.Icon ?? "home")" Size="Size.Large" />
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" HtmlTag="h1">@PageName()</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(IsOwner ? $"You own this home · {_sharings.Count} other member(s)" : "Shared with you")
                        </MudText>
                    </div>
                </div>

                <div class="d-flex align-center gap-2">
                    <MudTooltip Text="Refresh">
                        <MudIconButton Icon="@Icons.Material.Rounded.Refresh" aria-label="Refresh" OnClick="RefreshPage" />
                    </MudTooltip>
                    @if (IsOwner)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.Check"
                                   Disabled="@(!HasChanges())"
                                   OnClick="SaveChanges">
                            Save
                        </MudButton>
                    }
                </div>
            </div>

            <MudGrid Spacing="3">

                <MudItem xs="12" md="6">
                    <MudStack Spacing="3">

                        <MudPaper Outlined="true" Class="pa-4 rounded-lg">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">General</MudText>

                            <MudTextField Label="Name"
                                          Value="_name"
                                          Disabled="!IsOwner"
                                          T="string"
                                          Immediate="true"
                                          ValueChanged="@(v => { _name = v; StateHasChanged(); return Task.CompletedTask; })"/>

                            <MudSelect T="string"
                                       Label="Icon"
                                       Disabled="!IsOwner"
                                       ValueChanged="@(v => { _icon = v; StateHasChanged(); return Task.CompletedTask; })"
                                       ToStringFunc="@(v => v.ToIconLabel())"
                                       Value="_icon">

                                @if (!string.IsNullOrEmpty(_icon) && _icon is not ("home" or "flat" or "work"))
                                {
                                    <MudSelectItem Value="@_icon">
                                        <SensIcon Icon="@_icon" Class="mr-2" /> @_icon.ToIconLabel()
                                    </MudSelectItem>
                                }

                                <MudSelectItem Value="@("home")">
                                    <SensIcon Icon="home" Class="mr-2" /> Home
                                </MudSelectItem>

                                <MudSelectItem Value="@("flat")">
                                    <SensIcon Icon="flat" Class="mr-2" /> Flat
                                </MudSelectItem>

                                <MudSelectItem Value="@("work")">
                                    <SensIcon Icon="work" Class="mr-2" /> Work
                                </MudSelectItem>

                            </MudSelect>
                        </MudPaper>

                        @if (IsOwner)
                        {
                            @if (_hasDataSource)
                            {
                                <SensDataSourceState ConnectionStatus="@_connectionState"
                                                     Name="@_dsName"
                                                     Server="@_dsServer"
                                                     Port="@_dsPort"
                                                     HomeMode="true">
                                    <Actions>
                                        <MudButton Variant="Variant.Text"
                                                   EndIcon="@Icons.Material.Rounded.ChevronRight"
                                                   Href="@($"/datasources/details/{Current?.DataSource?.Id}")">
                                            Open
                                        </MudButton>
                                    </Actions>
                                </SensDataSourceState>
                            }
                            else
                            {
                                <MudPaper Outlined="true" Class="pa-4 rounded-lg d-flex flex-column gap-2">
                                    <MudText Typo="Typo.subtitle1">Data source</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        This home has no MQTT broker, so devices cannot send or receive data.
                                    </MudText>
                                    <div>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Rounded.Link"
                                                   OnClick="AssignDataSource">
                                            Link data source
                                        </MudButton>
                                    </div>
                                </MudPaper>
                            }
                        }

                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudStack Spacing="3">

                        @if (IsOwner)
                        {
                            <MudPaper Outlined="true" Class="pa-4 rounded-lg">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudText Typo="Typo.subtitle1" Class="flex-grow-1">People with access</MudText>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Rounded.PersonAdd"
                                               OnClick="InviteToHome">
                                        Invite
                                    </MudButton>
                                </div>

                                <div class="d-flex align-center gap-3 py-2">
                                    <MudAvatar Size="Size.Small" Color="Color.Primary">@Initial(UserService.Details?.Email)</MudAvatar>
                                    <MudText Typo="Typo.body2" Class="flex-grow-1 text-truncate">@(UserService.Details?.Email ?? "You")</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Owner</MudChip>
                                </div>

                                @foreach (var sharing in _sharings)
                                {
                                    <MudDivider />
                                    <div class="d-flex align-center gap-3 py-2">
                                        <MudAvatar Size="Size.Small">@Initial(sharing.FriendEmail)</MudAvatar>
                                        <MudText Typo="Typo.body2" Class="flex-grow-1 text-truncate">@sharing.FriendEmail</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@SharingLabel(sharing.SharingType)</MudChip>
                                        <MudIconButton Icon="@Icons.Material.Rounded.PersonRemove"
                                                       Size="Size.Small"
                                                       aria-label="@($"Remove {sharing.FriendEmail}")"
                                                       OnClick="() => RemoveSharing(sharing.SharingId)" />
                                    </div>
                                }

                                @if (_sharings.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                                        No one has joined yet. Invite household members so they can control devices.
                                    </MudText>
                                }
                            </MudPaper>
                        }

                        <MudPaper Outlined="true" Class="pa-4 rounded-lg" Style="border-color: var(--mud-palette-error);">
                            <MudStack Spacing="3">
                                @if (IsOwner)
                                {
                                    @if (_hasDataSource)
                                    {
                                        <div class="d-flex flex-wrap align-center gap-3">
                                            <div class="flex-grow-1">
                                                <MudText Typo="Typo.subtitle1" Color="Color.Error">Unlink data source</MudText>
                                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Devices stop updating until you link another source.</MudText>
                                            </div>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="UnlinkDataSource">Unlink</MudButton>
                                        </div>
                                        <MudDivider />
                                    }
                                    <div class="d-flex flex-wrap align-center gap-3">
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.subtitle1" Color="Color.Error">Delete home</MudText>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Removes rooms, devices and access for all members.</MudText>
                                        </div>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteHome">Delete</MudButton>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap align-center gap-3">
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.subtitle1" Color="Color.Error">Leave home</MudText>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">You lose access until the owner invites you again.</MudText>
                                        </div>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Rounded.ExitToApp" OnClick="LeaveHome">Leave</MudButton>
                                    </div>
                                }
                            </MudStack>
                        </MudPaper>

                    </MudStack>
                </MudItem>
            </MudGrid>

        </MudContainer>
    </Content>
</SensPage>

@code {
    private bool _loading = true;
    private bool _failedToLoad = true;

    private HomeDetails? Current;

    private string? _name;
    private string? _icon;

    private bool _hasDataSource;
    private string _connectionState = "Loading";
    private string _dsName = "Unknown";
    private string _dsServer = "Unknown";
    private int _dsPort;

    private List<SharingDto> _sharings = new();

    private List<BreadcrumbItem> Breadcrumbs => [
        new("My homes", "/homes/list", false, $"{Icons.Material.Filled.Home}"),
        new($"{PageName()}", "/homes/details", false, $"{Icons.Material.Filled.Home}")
    ];

    protected override async Task OnInitializedAsync()
    {
        await RefreshPage();
    }

    private async Task RefreshPage()
    {
        try
        {
            _loading = true;

            await UserService.Initialize();
            // The page can be opened directly (reload, link), before the dashboard loaded the home.
            await HomeService.Initialize();
            await HomeService.RefreshCurrentHome();

            Current = HomeService.CurrentHome;

            if (Current is null)
                return;

            _name = Current.Name;
            _icon = Current.Icon;


            if (Current.IsOwner)
            {
                await LoadDataSource();

                var response = await SharingIntegrationService.GetSharingsAsync(Current.Id);
                _sharings = response.Items;
            }


            _failedToLoad = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load page");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadDataSource()
    {
        if ((!Current?.IsOwner ?? false) || Current?.DataSource is null || Current?.DataSource?.Id is null)
        {
            _hasDataSource = false;
            return;
        }

        try
        {
            _hasDataSource = true;

            _dsName = Current!.DataSource?.Name ?? "Unknown";

            var result = await BrokerIntegrationService.GetClientStateAsync(Current.DataSource!.Id);

            _connectionState = result.ConnectionStatus;

            var brokerResult = await BrokerService.GetBroker(Current.DataSource!.Id);

            _dsServer = brokerResult.Value.Url ?? "Unknown";
            _dsPort = brokerResult.Value.Port;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load datasource");
            _connectionState = "Unknown";
        }
    }

    private string PageName() => Current?.Name ?? "Home";

    private bool IsOwner => Current?.IsOwner == true;

    private static string Initial(string? email) =>
        string.IsNullOrEmpty(email) ? "?" : email[..1].ToUpperInvariant();

    private static string SharingLabel(string sharingType) => sharingType switch
    {
        "Display" => "Can use",
        "Manage" => "Can manage",
        _ => sharingType
    };

    private bool HasChanges()
    {
        if (Current is null) return false;

        return _name != Current.Name
            || _icon != Current.Icon;
    }

    private async Task SaveChanges()
    {
        _loading = true;

        var result = await HomeService.UpdateHome(_name!, _icon!, null, null);

        try
        {
            if (result.IsSuccess)
            {
                Snackbar.Add("Home updated", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Errors.First().Description ?? "Error", Severity.Error);
            }

            await RefreshPage();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteHome()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            "Delete this home?",
            yesText: "Delete",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        if (confirm != true)
            return;

        var result = await HomeService.DeleteCurrentHome();

        if (result.IsSuccess)
        {
            Snackbar.Add("Home deleted", Severity.Success);
            Navigation.NavigateTo("/");
        }
    }

    private async Task LeaveHome()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm",
            "Sure to leave this home?",
            yesText: "Leave",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        if (confirm != true)
            return;

        await HomeService.LeaveAndRefresh();

        Snackbar.Add("Left home", Severity.Success);

        Navigation.NavigateTo("/");
    }

    private async Task AssignDataSource()
    {
        var dialog = await DialogService.ShowAsync<SelectDataSourceDialog>(
            "Select Data Source",
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var dataSourceId = result.Data as string;

            _loading = true;

            try
            {
                var updateResult = await HomeService.UpdateHomeDataSources(dataSourceId!);

                if (updateResult.IsFailure)
                {
                    Snackbar.Add(updateResult.Errors.First().Description, Severity.Error);
                    return;
                }

                await RefreshPage();
            }
            finally
            {
                _loading = false;
            }
        }
    }

    private async Task UnlinkDataSource()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Unlink data source",
            "Devices in this home stop updating until you link another data source.",
            yesText: "Unlink",
            cancelText: "Cancel",
            options: new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        if (confirm != true)
            return;

        _loading = true;
        try
        {
            StateHasChanged();
            await HomesIntegrationService.DeleteHomeDataSourceAsync(Current!.Id);
            Snackbar.Add("Data source unlinked", Severity.Success);

            await RefreshPage();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to unlink data source", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task InviteToHome()
    {
        var dialog = await DialogService.ShowAsync<InviteToHomeDialog>($"Invite to {PageName()}",
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var data = (InviteToHomeDialog.InviteUserResult)result.Data;


            var sharingRequest = new CreateSharingRequest(Current?.Id, data.Email, data.Role);

            _loading = true;
            StateHasChanged();
            try
            {
                var sharingResponse = await SharingIntegrationService.CreateSharingAsync(sharingRequest);

                var parameters = new DialogParameters<ShareCodeDialog>
                {
                    { x => x.Email, data.Email },
                    { x => x.Code, sharingResponse.Password },
                    { x => x.ExpiresAtUtc, sharingResponse.ExpiresAtUtc }
                };

                await DialogService.ShowAsync<ShareCodeDialog>("Invitation created", parameters,
                    new DialogOptions
                    {
                        MaxWidth = MaxWidth.Small,
                        FullWidth = true,
                        CloseOnEscapeKey = true
                    });
            }
            catch (ApiException ex)
            {
                Snackbar.Add("Failed to share home with user, please check email.", Severity.Error);
            }
            finally
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task RemoveSharing(string sharingId)
    {
        _loading = true;
        try
        {
            await SharingIntegrationService.DeleteSharingAsync(sharingId);

            Snackbar.Add("User removed", Severity.Success);

            await RefreshPage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove sharing");
            Snackbar.Add("Failed to remove user", Severity.Error);
        }
    }
}