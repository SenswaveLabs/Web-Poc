@page "/homes/list"
@attribute [Authorize]

@using Senswave.Web.Components.Homes
@using Senswave.Web.Homes.Components
@using Senswave.Web.Homes.Models
@using Senswave.Web.Homes.Services
@using Senswave.Web.Shared.Components
@using Senswave.Web.Shared.Components.Enums
@using Senswave.Web.DataSources.Services

@inject IDialogService DialogService
@inject IHomeService HomeService
@inject ILogger<List> Logger
@inject NavigationManager Navigation
@inject IBrokerService BrokerService

<PageTitle>My Homes</PageTitle>

<SensPage Loading="@_loading" FailedToLoad="@_failedToLoad" RefreshContent="@RefreshPage" Breadcrumbs="@Breadcrumbs">
    <LoadingContent>

        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="d-flex flex-column">
            <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="m-1">
                <MudSkeleton Width="256px" />
            </MudContainer>
            <MudGrid Spacing="0" Class="p-0 d-flex flex-row flex-wrap">
                <MudItem xs="12" sm="12" md="6" lg="4" xl="4" xxl="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;"  />
                </MudItem>
                <MudItem xs="12" sm="12" md="6" lg="4" xl="4" xxl="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;" />
                </MudItem>
                <MudItem xs="12" sm="12" md="6" lg="4" xl="4" xxl="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;" />
                </MudItem>
                <MudItem xs="12" sm="12" md="6" lg="4" xl="4" xxl="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;" />
                </MudItem>
                <MudItem xs="12" sm="12" md="6" lg="4" xl="4" xxl="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Class="m-2" Style="min-height:96px;" />
                </MudItem>
            </MudGrid>
        </MudContainer>
        
    </LoadingContent>
    <Content>
        <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="d-flex flex-column gap-3 pb-3">

            @if (Homes.Count == 0)
            {
                <div class="d-flex flex-column align-center gap-3 py-6 mx-auto" style="max-width: 520px; width: 100%; text-align: center;">
                    <MudImage Src="icon-192.png" Width="64" Height="64" Alt="" Class="rounded-lg" />
                    <MudText Typo="Typo.h5" HtmlTag="h1">Welcome to Senswave</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">
                        Got a code from someone in your household? Join their home. Setting up your own devices? Follow three steps.
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Rounded.Link"
                               OnClick="JoinHomeDialog">
                        I have an invitation code
                    </MudButton>

                    <div class="d-flex flex-column gap-2 mt-2" style="width: 100%; text-align: left;">
                        <MudPaper Outlined="true" Class="pa-3 rounded-lg d-flex align-center gap-3">
                            <MudAvatar Size="Size.Small" Color="@(_hasDataSource ? Color.Success : Color.Primary)">
                                @if (_hasDataSource)
                                {
                                    <MudIcon Icon="@Icons.Material.Rounded.Check" Size="Size.Small" />
                                }
                                else
                                {
                                    <span>1</span>
                                }
                            </MudAvatar>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.subtitle2">Add a data source</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Address of your MQTT broker, for example HiveMQ Cloud</MudText>
                            </div>
                            @if (!_hasDataSource)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/datasources">Add</MudButton>
                            }
                        </MudPaper>

                        <MudPaper Outlined="true" Class="pa-3 rounded-lg d-flex align-center gap-3">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">2</MudAvatar>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.subtitle2">Create a home</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Then link it to the data source</MudText>
                            </div>
                            <MudButton Variant="@(_hasDataSource ? Variant.Filled : Variant.Outlined)"
                                       Color="@(_hasDataSource ? Color.Primary : Color.Default)"
                                       Size="Size.Small"
                                       OnClick="AddHomeDialog">
                                Create
                            </MudButton>
                        </MudPaper>

                        <MudPaper Outlined="true" Class="pa-3 rounded-lg d-flex align-center gap-3">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">3</MudAvatar>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.subtitle2">Add your first device</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Operations and widgets can be set up later</MudText>
                            </div>
                        </MudPaper>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap align-center justify-space-between gap-2">
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" HtmlTag="h1">My homes</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Homes you own and homes shared with you. Pick one to open its dashboard.</MudText>
                    </div>
                    <div class="d-flex align-center gap-2">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Rounded.Link"
                                   OnClick="JoinHomeDialog">
                            Join
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.Add"
                                   OnClick="AddHomeDialog">
                            Home
                        </MudButton>
                    </div>
                </div>

                <MudGrid Spacing="3" Class="p-0 d-flex flex-row flex-wrap">

                    @foreach (var home in Homes)
                    {
                        <MudItem xs="12" sm="12" md="6" lg="4" xl="4" xxl="4">
                            <SensHome Home="@home" OnClick="() => HomeSelected(home.Id)" />
                        </MudItem>
                    }

                    <MudItem xs="6" sm="6" md="3" lg="2" xl="2" xxl="2">
                        <SensListAction Title="Add home" OnClick="AddHomeDialog"/>
                    </MudItem>

                    <MudItem xs="6" sm="6" md="3" lg="2" xl="2" xxl="2">
                        <SensListAction Title="Join home" Type="SensListActionType.Join" OnClick="JoinHomeDialog" />
                    </MudItem>

                </MudGrid>
            }

        </MudContainer>
    </Content>
</SensPage>

@code {
    private bool _hasDataSource;

    private bool _loading = true;
    private bool _failedToLoad = true;

    private List<Home> Homes { get; set; } = [];

    private List<BreadcrumbItem> Breadcrumbs => [
        new("My homes", "/homes/list", false, $"{Icons.Material.Filled.Home}")
    ];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await RefreshPage();
    }

    private async Task RefreshPage()
    {
        try
        {
            _loading = true;

            var result = await HomeService.GetHomes();

            if (result.IsFailure)
            {
                Logger.LogError("Failed to load page.");
                return;
            }

            Homes = result.Value;

            if (Homes.Count == 0)
            {
                var brokers = await BrokerService.GetBrokers();
                _hasDataSource = brokers.IsSuccess && brokers.Value.Count > 0;
            }

            _failedToLoad = false;
        }
        catch (Exception ex)
        {
            _failedToLoad = true;
            Logger.LogError(ex, "Failed to load page.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HomeSelected(string id)
    {
        try
        {
            _loading = true;

            var result = await HomeService.ChangeHome(id);

            if (result.IsFailure)
            {
                Logger.LogError("Failed to change home.");
                return;
            }

            Navigation.NavigateTo("/");
            _failedToLoad = false;
        }
        catch (Exception ex)
        {
            _failedToLoad = true;
            Logger.LogError(ex, "Failed to load page.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddHomeDialog()
    {
        var dialog = await DialogService.ShowAsync<AddHomeDialog>("Create Home",
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            await RefreshPage();
        }
    }

    private async Task JoinHomeDialog()
    {
        var dialog = await DialogService.ShowAsync<JoinHomeDialog>("Join Home",
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true
            });


        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            await RefreshPage();
        }
    }
}
