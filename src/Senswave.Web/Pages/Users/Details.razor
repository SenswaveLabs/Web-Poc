@page "/users/details"
@attribute [Authorize]

@using Senswave.Web.Homes.Services
@using Senswave.Web.Users.Auth.Services
@using Senswave.Web.Users.Users.Services
@using Senswave.Web.Shared.Components

@inject NavigationManager Navigation
@inject IUserService UserService
@inject ISnackbar Snackbar
@inject IAuthenticationService AuthenticationService
@inject IDialogService DialogService
@inject ILogger<Details> Logger

<PageTitle>Settings</PageTitle>

<SensPage Loading="false" FailedToLoad="false" RefreshContent="async () => {}">
    <Content>
        <MudContainer Gutters="false" MaxWidth="MaxWidth.Small" Class="d-flex flex-column gap-3 mx-0">

            <MudText Typo="Typo.h5" HtmlTag="h1">Settings</MudText>

            <MudPaper Outlined="true" Class="pa-4 rounded-lg d-flex flex-wrap align-center gap-3">
                <MudAvatar Color="Color.Primary">@UserEmail?.FirstOrDefault().ToString().ToUpper()</MudAvatar>
                <div class="flex-grow-1" style="min-width: 0;">
                    <MudText Typo="Typo.subtitle1" Class="text-truncate">@UserEmail</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Signed in</MudText>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Class="no-print"
                           StartIcon="@Icons.Material.Rounded.Logout"
                           OnClick="Logout">
                    Log out
                </MudButton>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-4 rounded-lg d-flex flex-column gap-2 no-print">
                <MudText Typo="Typo.subtitle1">Appearance</MudText>
                <MudToggleGroup T="string"
                                Value="@SelectedTheme"
                                ValueChanged="OnThemeChanged"
                                SelectionMode="SelectionMode.SingleSelection"
                                Color="Color.Primary"
                                CheckMark="true"
                                Outlined="true"
                                Class="flex-wrap"
                                aria-label="Theme">
                    @foreach (var theme in ThemeOptions)
                    {
                        <MudToggleItem Value="@theme.Item2" Text="@theme.Item1" />
                    }
                </MudToggleGroup>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">High contrast increases text and border contrast for low vision.</MudText>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-4 rounded-lg no-print" Style="border-color: var(--mud-palette-error);">
                <div class="d-flex flex-wrap align-center gap-3">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.subtitle1" Color="Color.Error">Remove account</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Deletes your homes, devices and data sources. This cannot be undone.</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               OnClick="ConfirmRemoveAccount">
                        Remove account…
                    </MudButton>
                </div>
            </MudPaper>

        </MudContainer>
    </Content>
</SensPage>

@code {
    string UserEmail = "";
    string SelectedTheme = "default";
    string SelectedLanguage = "english";

    List<(string, string)> ThemeOptions = new()
    {
        ("Default", "default"),
        ("Light", "light"),
        ("Dark", "dark"),
        ("High Contrast", "highcontrast"),
    };

    List<(string, string)> LanguageOptions = new()
    {
        ("English", "en")
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();

        UserEmail = UserService.Details.Email;
        SelectedTheme = UserService.Details.Theme;
        SelectedLanguage = UserService.Details.Language; 

    }

    async Task OnThemeChanged(string theme)
    {
        var result = await UserService.OverrideSettings(theme, SelectedLanguage);

        if (result.IsFailure)
        {
            Snackbar.Add("Failed to update theme", Severity.Error);
        } 
        else
        {
            SelectedTheme = theme;
        }
    }

    async Task OnLanguageChanged(string lang)
    {
        var result = await UserService.OverrideSettings(SelectedTheme, lang);

        if (result.IsFailure)
        {
            Snackbar.Add("Failed to update language.", Severity.Error);
        }
        else
        {
            SelectedLanguage = lang;
        }
    }

    async Task Logout()
    {
        await AuthenticationService.Logout();
    }

    async Task ConfirmRemoveAccount()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "Remove account",
            "Your homes, devices and data sources will be deleted. This cannot be undone.",
            yesText: "Remove",
            cancelText: "Cancel");

        if (result == true)
        {
            await RemoveAccount();
        }
    }

    async Task RemoveAccount()
    {
        try
        {
            await UserService.RemoveAccount();

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove account.");
            Snackbar.Add("Failed to remove account.", Severity.Error);
        }
    }

}
