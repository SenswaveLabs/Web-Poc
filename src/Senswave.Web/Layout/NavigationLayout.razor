@using Senswave.Web.Components.Navigation
@using Senswave.Web.Homes.Services
@using Senswave.Web.Shared.Extensions
@using Senswave.Web.Shared.Services
@using Senswave.Web.Users.Auth.Services

@inject ILoadingService LoadingService
@inject ISnackbar Snackbar
@inject IAuthenticationService authenticationService
@inject IHomeService HomeService
@implements IDisposable

@* Mobile Navigation *@
<MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
    <MudAppBar Dense="true" Elevation="1">
        <MudImage Src="icon-192.png" Width="32" Height="32" Alt="Senswave" Class="rounded mr-3" />
        <HomeSwitcher Color="Color.Inherit" />
        <MudSpacer />
    </MudAppBar>
    <BottomNavigation />
</MudHidden>

@* Tablet Navigation *@
<MudHidden Breakpoint="Breakpoint.Xs">
    <MudHidden Breakpoint="Breakpoint.LgAndUp">
        <MudAppBar Class="pl-0">
            <MudIconButton aria-label="Toggle navigation" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            <HomeSwitcher Color="Color.Inherit" />
            <MudSpacer />
        </MudAppBar>
        <MudDrawer Fixed="true" 
                   Variant="@DrawerVariant.Mini" 
                   @bind-Open="_drawerOpen"
                   OpenMiniOnHover="true" 
                   Breakpoint="Breakpoint.None"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="1">

           

            <NavigationMenu />

            @if (_drawerOpen)
            {
                <MudItem Class="text-center p-2 pb-4">
                    <MudText Typo="Typo.subtitle2">© 2026 Senswave</MudText>
                </MudItem>
            }

        </MudDrawer>
    </MudHidden>
</MudHidden>

@* Desktop Navigation *@
<MudHidden Breakpoint="Breakpoint.Xs">
    <MudHidden Breakpoint="Breakpoint.MdAndDown">
        @* <MudAppBar>
            <MudSpacer />

        </MudAppBar> *@
        <MudDrawer Open="true"
                   Width="220px"
                   Variant="DrawerVariant.Persistent"
                   Elevation="1">

            <MudDrawerHeader Class="d-flex align-center gap-2 px-4 pt-4 pb-2">
                <MudImage Src="icon-192.png" Width="32" Height="32" Alt="" Class="rounded" />
                <MudText Typo="Typo.h6">Senswave</MudText>
            </MudDrawerHeader>
            <div class="px-3 pb-3">
                <HomeSwitcher FullWidth="true" />
            </div>
            <NavigationMenu/>
            <MudItem Class="text-center p-2 pb-4">
                <MudText Typo="Typo.subtitle2">© 2026 Senswave</MudText>
            </MudItem>
        </MudDrawer>
    </MudHidden>
</MudHidden>

@code {

    bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        HomeService.OnChange += Rerender;

        // Menu items depend on the current home, also when the app starts on a page other than the dashboard.
        await HomeService.Initialize();
    }

    public void Dispose()
    {
        HomeService.OnChange -= Rerender;
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    void Rerender()
    {
        StateHasChanged();
    }
}
