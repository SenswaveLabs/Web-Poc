@using Senswave.Web.Homes.Models
@using Senswave.Web.Homes.Services
@using Senswave.Web.Shared.Extensions

@implements IDisposable

@inject IHomeService HomeService
@inject NavigationManager Navigation
@inject ILogger<HomeSwitcher> Logger

@if (HomeService.CurrentHome is null)
{
    <MudButton Variant="Variant.Outlined"
               Color="@Color"
               FullWidth="@FullWidth"
               StartIcon="@Icons.Material.Rounded.Home"
               Href="/homes/list">
        Choose home
    </MudButton>
}
else
{
    <MudMenu FullWidth="@FullWidth"
             Class="@($"home-switcher-menu {(FullWidth ? "home-switcher-menu--full" : string.Empty)}")"
             AnchorOrigin="Origin.BottomLeft"
             TransformOrigin="Origin.TopLeft"
             PopoverClass="home-switcher-popover"
             AriaLabel="Switch home">
        <ActivatorContent>
            <button type="button"
                    class="@($"home-switcher {(Color == Color.Inherit ? "home-switcher--flat" : string.Empty)} d-flex align-center gap-2 px-2 py-1 cursor-pointer")"
                    aria-label="@($"Home: {HomeService.CurrentHome.Name}. Switch home")"
                    @onclick="context.ToggleAsync"
                    title="@HomeService.CurrentHome.Name"
                    style="@($"color: {(Color == Color.Inherit ? "inherit" : "var(--mud-palette-text-primary)")};")">
                <MudIcon Icon="@HomeService.CurrentHome.Icon.TranslateIcon()" Color="@(Color == Color.Inherit ? Color.Inherit : Color.Primary)" Size="Size.Small" Class="flex-shrink-0" />
                <span class="d-flex flex-column flex-grow-1" style="min-width:0; line-height:1.2;">
                    <span class="home-switcher__label">Home</span>
                    <span class="home-switcher__name text-truncate" style="font-weight:500;">@HomeService.CurrentHome.Name</span>
                </span>
                <MudIcon Icon="@Icons.Material.Rounded.UnfoldMore" Size="Size.Small" Color="Color.Inherit" Class="flex-shrink-0" />
            </button>
        </ActivatorContent>
        <ChildContent>
            @foreach (var home in _homes)
            {
                var id = home.Id;
                <MudMenuItem Icon="@home.Icon.TranslateIcon()" OnClick="() => SwitchHome(id)">
                    <div class="d-flex align-center gap-2" style="min-width:0;">
                        <span class="home-switcher__name" title="@home.Name">@home.Name</span>
                        @if (home.Id == HomeService.CurrentHome?.Id)
                        {
                            <MudIcon Icon="@Icons.Material.Rounded.Check" Size="Size.Small" Color="Color.Primary" Class="flex-shrink-0" />
                        }
                    </div>
                </MudMenuItem>
            }
            <MudDivider Class="my-1" />
            <MudMenuItem Icon="@Icons.Material.Rounded.SwapHoriz" Href="/homes/list">All homes</MudMenuItem>
        </ChildContent>
    </MudMenu>
}

<style>
    /* The menu and its button never grow past the space they get, so long names are truncated. */
    .home-switcher-menu {
        min-width: 0;
        max-width: 100%;
    }

    .home-switcher-menu--full {
        display: flex;
        width: 100%;
    }

    .home-switcher {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        overflow: hidden;
        background: transparent;
        font: inherit;
        text-align: left;
        border-radius: 8px;
        border: 1px solid var(--mud-palette-lines-default);
        min-height: 44px;
    }

    .home-switcher--flat {
        border-color: transparent;
    }

    .home-switcher--flat:hover {
        background-color: rgba(127, 127, 127, 0.15);
    }

    .home-switcher--flat .home-switcher__name {
        font-size: 1.05rem;
    }

    .home-switcher__name {
        display: block;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    /* The list opens below the switcher and must fit on narrow phones too. */
    .mud-popover.home-switcher-popover {
        max-width: calc(100vw - 32px) !important;
        overflow: hidden;
    }

    .home-switcher-popover .mud-menu-list {
        min-width: 0;
    }

    .home-switcher-popover .mud-menu-item,
    .home-switcher-popover .mud-menu-item-text {
        min-width: 0;
    }

    .home-switcher__label {
        font-size: 0.7rem;
        opacity: 0.75;
    }
</style>

@code {
    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public Color Color { get; set; } = Color.Default;

    private List<Home> _homes = [];

    protected override async Task OnInitializedAsync()
    {
        HomeService.OnChange += Rerender;
        await LoadHomes();
    }

    private async Task LoadHomes()
    {
        var result = await HomeService.GetHomes();

        if (result.IsFailure)
        {
            Logger.LogWarning("Failed to load homes for the home switcher.");
            return;
        }

        _homes = result.Value;
    }

    private async Task SwitchHome(string id)
    {
        if (id == HomeService.CurrentHome?.Id)
            return;

        var result = await HomeService.ChangeHome(id);

        if (result.IsFailure)
        {
            Logger.LogError("Failed to change home to {HomeId}", id);
            return;
        }

        // Pages load data for the current home on init; "/" redirects to the dashboard and recreates it.
        Navigation.NavigateTo("/");
    }

    private void Rerender()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadHomes();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        HomeService.OnChange -= Rerender;
    }
}
