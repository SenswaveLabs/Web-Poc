@using MudBlazor

<MudPaper Outlined="true" Class="pa-4 rounded-lg" Style="min-width:0; overflow:hidden;">

    <MudStack Spacing="3">
        @if (HomeMode)
        {
            <MudText Typo="Typo.subtitle1">Data source</MudText>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="min-width:0;">

            <MudIcon Icon="@Icons.Material.Rounded.Dns"
                     Size="Size.Large"
                     Color="Color.Primary" />

            <MudStack Spacing="0" Style="min-width:0;">
                <MudText Typo="Typo.h6" Class="text-truncate">@Name</MudText>

                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="overflow-wrap:anywhere;">
                    @Server:@Port
                </MudText>
            </MudStack>

        </MudStack>

        <div class="d-flex flex-wrap align-center gap-3 pa-3 rounded-lg" style="@StatusStyle" role="status">

            <MudIcon Icon="@ChipIcon"
                     Color="@ChipColor"
                     Size="Size.Medium" />

            <MudStack Spacing="0" Class="flex-grow-1">
                <MudText Typo="Typo.subtitle2">@Message</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @Description
                </MudText>
            </MudStack>

            @Actions

        </div>

    </MudStack>

</MudPaper>

@code {

    [Parameter]
    public bool HomeMode { get; set; } = false;

    [Parameter]
    public string ConnectionStatus { get; set; } = "Unknown";

    [Parameter]
    public string Name { get; set; } = "Unknown";

    [Parameter]
    public string Server { get; set; } = "Unknown";

    [Parameter]
    public int Port { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    private string StatusStyle => ConnectionStatus switch
    {
        "Working" => "background-color: rgba(var(--mud-palette-success-rgb), 0.12);",
        "Restarting" => "background-color: rgba(var(--mud-palette-warning-rgb), 0.12);",
        "Stopped" or "Invalid" => "background-color: rgba(var(--mud-palette-error-rgb), 0.10);",
        _ => "background-color: var(--mud-palette-action-default-hover);"
    };

    private string Message => ConnectionStatus switch
    {
        "Loading" => "Loading",
        "Invalid" => "Invalid",
        "Working" => "Connected",
        "Restarting" => "Restarting",
        "Stopped" => "Stopped",
        "NotStarted" => "Not started",
        _ => "Unknown"
    };

    private string Description => ConnectionStatus switch
    {
        "Loading" => "Checking broker status",
        "Invalid" => "Invalid state failed to update",
        "Working" => "Connection working correctly",
        "Restarting" => "Broker is restarting",
        "Stopped" => "Broker has been stopped",
        "NotStarted" => "Broker has not been started",
        _ => "Failed to determine broker state"
    };

    private Color ChipColor => ConnectionStatus switch
    {
        "Loading" => Color.Secondary,
        "Invalid" => Color.Dark,
        "Working" => Color.Success,
        "Restarting" => Color.Warning,
        "Stopped" => Color.Error,
        "NotStarted" => Color.Default,
        _ => Color.Default
    };

    private string ChipIcon => ConnectionStatus switch
    {
        "Loading" => Icons.Material.Filled.HourglassEmpty,
        "Invalid" => Icons.Material.Filled.ErrorOutline,
        "Working" => Icons.Material.Filled.CheckCircle,
        "Restarting" => Icons.Material.Filled.RestartAlt,
        "Stopped" => Icons.Material.Filled.StopCircle,
        "NotStarted" => Icons.Material.Filled.PauseCircle,
        _ => Icons.Material.Filled.HelpOutline
    };
}