@using MudBlazor
@using System.ComponentModel.DataAnnotations

<MudDialog>

    <DialogContent>

        <MudForm @ref="_form">

            <MudStack Spacing="3">

                <MudText Typo="Typo.body2">
                    Enter their email and choose what they can do. You get a code to send them.
                </MudText>

                <!-- EMAIL -->
                <MudTextField T="string"
                              Label="Email"
                              @bind-Value="_email"
                              Required="true"
                              Immediate="true" 
                              Validation="@(new EmailAddressAttribute { ErrorMessage = @"The email address is invalid" })" />

                <MudText Typo="Typo.subtitle2">Permission</MudText>
                <MudRadioGroup T="string" @bind-Value="_role" Required="true" RequiredError="Permission is required">
                    <MudRadio T="string" Value="@("Display")" Color="Color.Primary">
                        <div class="d-flex flex-column">
                            <span>Use</span>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Sees devices and controls them</MudText>
                        </div>
                    </MudRadio>
                    <MudRadio T="string" Value="@("Manage")" Color="Color.Primary">
                        <div class="d-flex flex-column">
                            <span>Manage</span>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Can also add and change devices and rooms</MudText>
                        </div>
                    </MudRadio>
                </MudRadioGroup>

            </MudStack>

        </MudForm>

    </DialogContent>

    <DialogActions>

        <MudButton Variant="Variant.Text"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_loading"
                   OnClick="Submit">

            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <span>Create invitation</span>
            }

        </MudButton>

    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    private MudForm? _form;

    private string _email = string.Empty;

    private string _role = "Display";

    private bool _loading = false;

    async Task Submit()
    {
        await _form!.Validate();

        if (!_form.IsValid)
            return;

        _loading = true;

        try
        {
            var result = new InviteUserResult(_email, _role);

            MudDialog!.Close(DialogResult.Ok(result));
        }
        finally
        {
            _loading = false;
        }
    }

    void Cancel()
    {
        MudDialog!.Cancel();
    }

    public record InviteUserResult(string Email, string Role);
}