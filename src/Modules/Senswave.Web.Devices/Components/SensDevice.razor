@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Senswave.Web.Devices.Integration
@using Senswave.Web.Devices.Services
@using Senswave.Web.Shared.Components
@using System.Text.Json
@using System.Text.Json.Nodes
@using Senswave.Web.Shared.Resulting

@inject ISnackbar Snackbar
@inject IErrorFactory ErrorFactory
@inject IDeviceIntegrationService DeviceIntegrationService
@inject IDeviceDetailsService DeviceDetailsService
@inject NavigationManager Navigation

<div class="@($"sens-device pa-3 cursor-pointer {(IsOn ? "sens-device--on" : string.Empty)}")"
     tabindex="0"
     role="button"
     aria-label="@($"Open {Device.Name}")"
     @onkeydown="(e) => OnKeyDown(e)"
     @onclick="HandleClick">

    <div class="d-flex align-center gap-3">

        <div class="sens-device__icon">
            <SensIcon Icon="@Device.Icon" Color="@(IsOn ? Color.Primary : Color.Default)" />
        </div>

        <div class="d-flex flex-column flex-grow-1" style="min-width:0;">
            <MudText Typo="Typo.subtitle1" Class="fw-bold text-truncate">@Device.Name</MudText>
            <MudText Typo="Typo.caption" Class="sens-device__muted text-truncate">
                @(HasRoomName() ? RoomName : "No room")
            </MudText>
        </div>

        <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            <MudMenu Icon="@Icons.Material.Rounded.MoreVert"
                     AriaLabel="@($"{Device.Name} options")"
                     Size="Size.Small"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Rounded.Tune" OnClick="NavigateToDetails">Configure</MudMenuItem>
            </MudMenu>
        </div>
    </div>

    <div class="d-flex align-center justify-space-between gap-2 mt-2" style="min-height:36px;">
        @if (IsSwitch)
        {
            <MudText Typo="Typo.body2">
                <b>@StateLabel</b>
            </MudText>

            <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                @if (_action)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-3" />
                }
                else
                {
                    <MudSwitch T="bool"
                               Value="@IsOn"
                               ValueChanged="HandleStateUpdate"
                               Color="Color.Primary"
                               aria-label="@($"Turn {Device.Name} {(IsOn ? "off" : "on")}")" />
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="sens-device__muted">Open controls</MudText>
            <MudIcon Icon="@Icons.Material.Rounded.ChevronRight" Class="sens-device__muted" />
        }
    </div>
</div>

@code {

    [Parameter]
    public DisplayDeviceDto Device { get; set; } = default!;

    [Parameter]
    public EventCallback<DisplayDeviceDto> OnClick { get; set; }

    private string RoomName { get; set; } = string.Empty;

    private bool _action = false;

    private bool IsSwitch => Device?.Tile?.Type == "Switch";

    private bool IsOn => IsSwitch && Device?.Tile?.Value?.GetValueKind() == JsonValueKind.True;

    private string StateLabel => Device?.Tile?.Value?.GetValueKind() switch
    {
        JsonValueKind.True => "On",
        JsonValueKind.False => "Off",
        _ => "No data"
    };

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (!string.IsNullOrEmpty(Device.RoomId))
        {
            RoomName = await DeviceDetailsService.GetRoomNameById(Device.RoomId);
        }
        else
        {
            RoomName = string.Empty;
        }
    }

    private async Task HandleStateUpdate(bool toSend)
    {
        try
        {
            _action = true;
            StateHasChanged();

            var request = new DeviceTileActionRequest(JsonValue.Create(toSend));

            await DeviceIntegrationService.ExecuteDeviceTileActionAsync(Device!.Id, request);

            Device?.Tile?.Value = JsonValue.Create(toSend);
        }
        catch (Refit.ApiException ex)
        {
            var error = await ErrorFactory.FromApiExceptionAsync(ex, "Failed to update device state");
            Snackbar.Add(error.Errors.First().Description, Severity.Error);
        }
        finally
        {
            _action = false;
        }
    }

    private bool HasRoomName() => RoomName != string.Empty;

    private void NavigateToDetails()
    {
        Navigation.NavigateTo($"/devices/details/{Device.Id}");
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(Device);
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            if (OnClick.HasDelegate)
                await OnClick.InvokeAsync(Device);
        }
    }
}
